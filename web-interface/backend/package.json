{
  "name": "web-interface-backend",
  "version": "1.0.0",
  "description": "Web interface backend proxy for Core Engineering System",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
